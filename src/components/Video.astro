---
interface Props {ja:boolean}
const {ja}=Astro.props;
---
<div class="official-video"><div class="video-stage" data-video-stage><button type="button" data-load-video aria-label={ja?'YouTubeの動画を読み込む':'Load YouTube video'}><span aria-hidden="true">▶</span><strong>{ja?'ミュージックビデオを観る':'Watch the music video'}</strong><small>{ja?'クリックするとYouTubeに接続します':'Click to connect to YouTube'}</small></button></div><h3>さよならを追い越して 午前零時の逃走線</h3><a class="text-link" href="https://www.youtube.com/watch?v=c6jviyQrxFA" target="_blank" rel="noopener noreferrer">YouTube ↗</a></div>
<script>
document.querySelectorAll<HTMLButtonElement>('[data-load-video]').forEach(button=>button.addEventListener('click',()=>{
const frame=document.createElement('iframe');
frame.src='https://www.youtube-nocookie.com/embed/c6jviyQrxFA';
frame.title='さよならを追い越して 午前零時の逃走線 | Tokyo Anime Music';
frame.allow='encrypted-media; picture-in-picture; fullscreen';frame.allowFullscreen=true;
button.parentElement?.replaceChildren(frame);frame.focus();
}));
</script>
<style>.video-stage{aspect-ratio:16/9;background:radial-gradient(ellipse at 70% 30%,#603353,#111831 70%);border:1px solid #67517f;border-radius:20px;overflow:hidden}.video-stage button{width:100%;height:100%;background:transparent;color:#fff;border:0;cursor:pointer;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:15px;padding:25px;font:inherit}.video-stage button span{font-size:32px;color:#ff9bd9}.video-stage small{color:#d1c5df}.video-stage :global(iframe){width:100%;height:100%;border:0}.official-video h3{font-size:18px;line-height:1.6}.official-video{min-width:0}</style>
