---
import Layout from '../layouts/Layout.astro';
import Character from './Character.astro';
import Catalog from './Catalog.astro';
import Video from './Video.astro';
import { releases } from '../data/catalog';
const featured = releases.find(r => r.id === 'release-b686b656efd3') ?? releases[0];
import SocialLinks from './SocialLinks.astro';
import { hyperfollow, href, type Lang, type Page } from '../data/site';
interface Props {lang: Lang; page: Page;}
const {lang, page} = Astro.props;
const ja = lang === 'ja';
const names = {home:'Home',music:'Music',videos:'Videos',streaming:'Streaming',about:'About',contact:'Contact'};
const title = page === 'home' ? 'Tokyo Anime Music — Where Anime Meets Music.' : names[page] + ' | Tokyo Anime Music';
const description = ja ? 'Tokyo Anime Musicの公式サイト。音楽、映像、配信リンクをお届けします。' : 'The official home of Tokyo Anime Music. Explore music, videos, and streaming links.';
---
<Layout lang={lang} page={page} title={title} description={description}>
{page === 'home' ? <>
<section class="hero" data-pointer-scene><div class="scene-atmosphere" aria-hidden="true"><div class="halo-ring"></div>{Array.from({length:18},(_,i)=><span class:list={["sky-particle",{petal:i%3===0}]} style={`--px:${10+(i*37)%85}%;--py:${8+(i*23)%74}%;--delay:${i*.08}s;--angle:${i*29}deg`} />)}</div><div class="pointer-glow" aria-hidden="true"></div>
<img class="hero-art" src="/images/tokyo-night.svg" alt="" fetchpriority="high" width="1600" height="1100" />
<div class="character-portrait"><div class="character-frame"><Character ja={ja} /><div class="character-caption"><span>TOKYO ANIME MUSIC</span><small>YOUR WORLD. YOUR SOUND.</small></div></div><span class="character-spark" aria-hidden="true">✦</span></div><div class="hero-content"><p class="eyebrow"><span></span> TOKYO ANIME MUSIC · OFFICIAL</p><h1>Where Anime<br/>Meets <em>Music.</em></h1><p class="hero-copy">{ja ? '日常を抜け出す、一曲に出会おう。' : 'Find the soundtrack to your own anime moment.'}</p><div class="actions"><a class="button primary" href={featured?.hyperfollow ?? hyperfollow} target="_blank" rel="noopener noreferrer"><span class="play-disc" aria-hidden="true">▶</span>{ja ? '音楽の世界へ' : 'Enter the music'} <span>↗</span></a><a class="button secondary" href={href(lang,'music')}>{ja ? '楽曲を探す' : 'Explore the music'} <span>→</span></a></div></div>
<div class="hero-invitation"><span class="sound-bars" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span><span>{ja ? 'あなたの日常に、アニメのような瞬間を。' : 'A different world. Just one play away.'}<small>{ja ? 'HyperFollowで配信先を選べます' : 'Choose where to listen on HyperFollow'}</small></span></div><div class="hero-bottom"><span>東京 / TOKYO</span><span>ANIME SPIRIT. J-POP SOUL.</span><a href="#discover">{ja ? 'もっと見る' : 'Scroll to discover'} ↓</a></div>
</section>
<section class="section" id="discover"><div class="section-heading"><div><p class="eyebrow">01 / THE MUSIC</p><h2>{ja ? '次のお気に入りを。' : 'Find your next feeling.'}</h2></div><a class="text-link" href={href(lang,'music')}>{ja ? '楽曲を見る' : 'Explore music'} ↗</a></div><div class="feature-card"><div class="cover-art" aria-hidden="true"><span>TOKYO<br/>ANIME<br/><i>MUSIC</i></span><small>THE SOUND OF A NEW WORLD</small></div><div class="feature-copy"><p class="eyebrow">START LISTENING</p><h3>{featured?.title ?? 'Tokyo Anime Music'}</h3><p>{ja ? '2026年10月12日リリース。Spotifyで配信を確認したシングルです。' : 'Released October 12, 2026. A single with verified availability on Spotify.'}</p><a class="button primary" href={featured?.hyperfollow ?? hyperfollow} target="_blank" rel="noopener noreferrer">{ja ? 'HyperFollowを開く' : 'Open HyperFollow'} ↗</a><small>{ja ? '新しいタブで開きます' : 'Opens in a new tab'}</small></div></div></section>
<section class="section two-columns"><div><p class="eyebrow">02 / IN MOTION</p><h2>{ja ? '音楽を、映像でも。' : 'Sound. Meet vision.'}</h2><p class="muted">{ja ? 'さよならを追い越して 午前零時の逃走線。音楽とともに、物語の中へ。' : 'Step into the story of さよならを追い越して 午前零時の逃走線.'}</p><a class="text-link" href={href(lang,'videos')}>{ja ? '動画ページへ' : 'Visit videos'} →</a></div><Video ja={ja} /></section>
<section class="section"><p class="eyebrow">POPULAR TRACKS</p><h2>{ja?'次の一曲は、人気曲から。':'Discover the favorites.'}</h2><p class="muted">{ja?'Spotify・Apple Musicの人気曲とYouTubeの人気動画をご紹介。':'Explore popular tracks on Spotify and Apple Music, plus popular channel videos on YouTube.'}</p><a class="button secondary" href={ja?'/ja/rankings/':'/rankings/'}>{ja?'人気曲を見る':'View popular tracks'} →</a></section><section class="section social-section"><p class="eyebrow">STAY CONNECTED</p><h2>{ja?'音楽の、その先へ。':'More music. More moments.'}</h2><p class="muted">{ja?'新曲や映像、日々の投稿を公式SNSで。':'Follow our official accounts for music, videos, and updates.'}</p><SocialLinks ja={ja}/></section><section class="closing"><p class="eyebrow">ONE WORLD. MANY WAYS TO LISTEN.</p><h2>{ja ? 'あなたのスタイルで、音楽を。' : 'Take the music with you.'}</h2><a class="button secondary" href={href(lang,'streaming')}>{ja ? '配信リンクを見る' : 'Find your listening destination'} ↗</a></section>
</> : <>
<section class="page-intro"><p class="eyebrow">TOKYO ANIME MUSIC / {names[page].toUpperCase()}</p><h1>{page === 'music' ? (ja ? '音楽の世界へ。' : 'Feel every note.') : page === 'videos' ? (ja ? '音と映像の世界。' : 'Music in motion.') : page === 'streaming' ? (ja ? 'ここから、聴こう。' : 'Press play. Go places.') : page === 'about' ? (ja ? 'Tokyo Anime Musicについて' : 'Where Anime Meets Music.') : (ja ? 'お問い合わせ' : 'Let’s connect.')}</h1></section>
<section class="section inner-content">
{page === 'music' && <><p><a class="text-link" href={ja?'/ja/rankings/':'/rankings/'}>{ja?'サービス別の人気曲を見る':'Popular tracks by platform'} →</a></p><Catalog ja={ja} /></>}
{page === 'videos' && <><Video ja={ja} /><p class="muted">{ja?'さらに多くの映像は公式YouTubeで。':'Explore more videos on our official YouTube channel.'}</p><a class="button secondary" href="https://www.youtube.com/@TokyoAnimeMusic" target="_blank" rel="noopener noreferrer">YouTube ↗</a></>}
{page === 'streaming' && <div class="streaming-grid">{[
 ['Spotify','https://open.spotify.com/artist/1DZmOid1iJozu92mvwcO5U'],
 ['Apple Music','https://music.apple.com/jp/artist/tokyo-anime-music/6782565755'],
 ['HyperFollow','https://hyperfollow.com/Tokyoanimemusic'],
 ['YouTube','https://www.youtube.com/@TokyoAnimeMusic']
 ].map(([name,url])=><a class="stream-destination" href={url} target="_blank" rel="noopener noreferrer"><span class="eyebrow">TOKYO ANIME MUSIC</span><h2>{name} ↗</h2><p>{ja?'公式ページを開く':'Open official page'}</p></a>)}</div>}
{page === 'about' && <div class="about-grid"><div class="cover-art" aria-hidden="true"><span>TOKYO<br/>ANIME<br/><i>MUSIC</i></span><small>WHERE ANIME MEETS MUSIC.</small></div><div><p class="eyebrow">OUR WORLD</p><h2>{ja ? 'アニメの感性と、音楽の力。' : 'Anime spirit. J-pop soul.'}</h2><p>{ja ? 'Tokyo Anime Musicの公式サイトへようこそ。世界中のアニメ音楽・J-POPファンへ、楽曲と映像をお届けします。' : 'Welcome to the official home of Tokyo Anime Music, bringing music and visuals to anime music and J-pop fans around the world.'}</p><p>{ja ? '東京の夜、ネオン、桜、星空。その色彩をまとった世界で、音楽との出会いをお楽しみください。' : 'Tokyo nights, neon light, cherry blossoms, and starry skies. A world of color, with music at its heart.'}</p><a class="text-link" href={href(lang,'music')}>{ja ? '楽曲の世界へ' : 'Step into the music'} →</a></div></div>}
{page === 'contact' && <div><h2>{ja?'公式SNSからお問い合わせください':'Get in touch through our official socials'}</h2><p class="muted">{ja?'お問い合わせ・コラボレーションのご相談は、公式SNSのメッセージ機能からお送りください。メッセージを送れない場合は、別の公式アカウントをご利用ください。':'For inquiries and collaborations, please use messaging on our official social accounts. If messaging is unavailable, try another account below.'}</p><SocialLinks ja={ja}/></div>}
</section></>}
</Layout>

<script>
  const scene = document.querySelector<HTMLElement>('[data-pointer-scene]');
  const motion = matchMedia('(prefers-reduced-motion: no-preference) and (hover: hover) and (pointer: fine)');
  if (scene) {
    let frame = 0;
    let x = 0;
    let y = 0;
    const reset = () => {
      cancelAnimationFrame(frame);
      frame = 0;
      scene.classList.remove('pointer-active');
      scene.style.removeProperty('--shift-x');
      scene.style.removeProperty('--shift-y');
    };
    scene.addEventListener('pointermove', (event: PointerEvent) => {
      if (!motion.matches || event.pointerType === 'touch') return;
      const bounds = scene.getBoundingClientRect();
      x = event.clientX - bounds.left;
      y = event.clientY - bounds.top;
      if (frame) return;
      frame = requestAnimationFrame(() => {
        scene.style.setProperty('--shift-x', ((x / bounds.width - .5) * 28) + 'px');
        scene.style.setProperty('--shift-y', ((y / bounds.height - .5) * 20) + 'px');
        scene.style.setProperty('--glow-x', x + 'px');
        scene.style.setProperty('--glow-y', y + 'px');
        scene.classList.add('pointer-active');
        frame = 0;
      });
    }, { passive: true });
    scene.addEventListener('pointerleave', reset);
    scene.addEventListener('pointercancel', reset);
    motion.addEventListener('change', reset);
    window.addEventListener('blur', reset);
  }
</script>