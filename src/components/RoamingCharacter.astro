---
import SingingPlayer from './SingingPlayer.astro';
interface Props { ja: boolean }
const {ja}=Astro.props;
---
<div class="roaming-character" data-roaming-character aria-hidden="true">
  <div class="walker-art">{['leg-back','leg-front','upper-body'].map(part=><img class={part} src="/images/walking-character.png" alt="" width="1024" height="1536" decoding="async" />)}<img class="singing-character-art" src="/images/singing-character.png" alt="" width="1024" height="1536" decoding="async" /><span class="singing-mouth-cover"></span><span class="singing-mouth"></span><svg class="singing-microphone" viewBox="0 0 1024 1536" aria-hidden="true"><g transform="rotate(57 525 500)"><rect x="497" y="515" width="56" height="235" rx="20" fill="#30263c" stroke="#df88ba" stroke-width="9"/><rect x="490" y="545" width="70" height="22" rx="8" fill="#f18bbd"/><ellipse cx="525" cy="487" rx="52" ry="68" fill="#a8adc8" stroke="#382a48" stroke-width="10"/><path d="M483 467h84M477 487h96M483 507h84M510 424v120M535 424v120" fill="none" stroke="#5c536f" stroke-width="7"/><path d="M489 652q-12-27 10-28l56 3q18 7 2 22l-40 1m-22 10 57 2q18 8 0 21l-46-2m-8 9 46 4q18 10-1 21l-39-3" fill="#ffd0b8" stroke="#a95d79" stroke-width="7" stroke-linecap="round"/></g></svg></div>
  <span class="walker-shadow"></span>
</div>
<button class="walker-toggle" data-walker-toggle aria-pressed="false" data-stop={ja?'キャラを休ませる':'Pause character'} data-start={ja?'キャラを歩かせる':'Let character walk'}>{ja?'キャラを休ませる':'Pause character'}</button>
<SingingPlayer ja={ja} />
<script>
const walker=document.querySelector<HTMLElement>('[data-roaming-character]');
const toggle=document.querySelector<HTMLButtonElement>('[data-walker-toggle]');
if(walker&&toggle){
 const reduced=matchMedia('(prefers-reduced-motion: reduce)');
 let paused=reduced.matches, x=24, target=24, rest=0, previous=0, frame=0;
 const bounds=()=>({min:12,max:Math.max(12,innerWidth-walker.offsetWidth-12)});
 const choose=()=>{const b=bounds();target=b.min+Math.random()*(b.max-b.min);};
 const render=()=>{walker.style.transform=`translate3d(${x}px,0,0)`;};
 const updateControl=()=>{toggle.textContent=paused?toggle.dataset.start!:toggle.dataset.stop!;toggle.setAttribute('aria-pressed',String(paused));walker.classList.toggle('walking',!paused&&rest<=0&&!walker.classList.contains('singing'));};
 const tick=(now:number)=>{
  const dt=Math.min((now-previous)/1000,.05);previous=now;
  if(walker.classList.contains('singing')){walker.classList.remove('walking');}
  else if(!paused&&!document.hidden){
   const b=bounds();x=Math.max(b.min,Math.min(b.max,x));
   if(rest>0){rest-=dt;walker.classList.remove('walking');if(rest<=0)choose();}
   else {const delta=target-x;const step=(innerWidth<600?24:36)*dt;
    if(Math.abs(delta)<=Math.max(step,2)){x=target;rest=1.5+Math.random()*3;walker.classList.remove('walking');}
    else{x+=Math.sign(delta)*step;walker.classList.add('walking');walker.style.setProperty('--lean',delta<0?'-3deg':'3deg');}
   }
   render();
  }
  if(!paused&&!document.hidden)frame=requestAnimationFrame(tick);
 };
 const start=()=>{cancelAnimationFrame(frame);previous=performance.now();if(!paused&&!document.hidden)frame=requestAnimationFrame(tick);};
 toggle.addEventListener('click',()=>{paused=!paused;updateControl();start();});
 reduced.addEventListener('change',()=>{paused=reduced.matches;updateControl();start();});
 document.addEventListener('visibilitychange',start);
 window.addEventListener('resize',()=>{const b=bounds();x=Math.min(x,b.max);target=Math.min(target,b.max);render();});
 choose();render();updateControl();start();
}
</script>
<style>
.singing-microphone{display:none;position:absolute;inset:0;width:100%;height:100%;z-index:4;overflow:visible}.singing .singing-microphone{display:block}.singing .walker-art,.singing .leg-front,.singing .leg-back{animation:none;transform:none}

.singing-mouth{display:none;position:absolute;z-index:3;left:52.7%;top:30.5%;width:5.7%;height:2.1%;border-radius:50%;background:#662237;border:1px solid #ad5761;box-shadow:0 0 0 2px #ffceb4;transform:rotate(10deg);transform-origin:center}.singing .singing-mouth{display:block;animation:sing-mouth .55s infinite}@keyframes sing-mouth{0%,100%{transform:rotate(10deg) scaleY(.25)}28%{transform:rotate(10deg) scaleY(1)}58%{transform:rotate(10deg) scaleY(.4)}80%{transform:rotate(10deg) scaleY(.8)}}@media(prefers-reduced-motion:reduce){.singing .singing-mouth{display:none}}

.roaming-character{position:fixed;bottom:16px;left:0;width:clamp(88px,10vw,148px);height:auto;aspect-ratio:2/3;z-index:25;pointer-events:none;user-select:none;mix-blend-mode:screen;will-change:transform}.walker-art{position:relative;width:100%;height:100%;transform-origin:50% 92%}.walker-art img{position:absolute;inset:0;display:block;width:100%;height:100%;object-fit:contain;mask-image:radial-gradient(ellipse 52% 55% at 48% 50%,#000 74%,transparent 99%)}.walker-art .upper-body{clip-path:inset(0 0 34% 0);z-index:2}.walker-art .leg-back{clip-path:polygon(34% 65%,53% 65%,51% 74%,43% 84%,44% 100%,22% 100%,22% 86%,42% 74%);transform-origin:48% 66%}.walker-art .leg-front{clip-path:polygon(53% 65%,68% 65%,69% 100%,44% 100%,43% 84%,51% 74%);transform-origin:57% 66%}.walking .leg-back{animation:leg-stride .8s ease-in-out infinite}.walking .leg-front{animation:leg-stride .8s ease-in-out -.4s infinite}@keyframes leg-stride{0%,100%{transform:rotate(-7deg) translateY(-1px)}50%{transform:rotate(7deg) translateY(1px)}}.walking .walker-art{animation:character-step .4s ease-in-out infinite}.walker-shadow{position:absolute;bottom:0;left:25%;width:50%;height:6px;background:#ef83be55;border-radius:50%;filter:blur(3px)}.walker-toggle{position:fixed;right:12px;bottom:12px;z-index:26;padding:9px 14px;border:1px solid #d49abb66;border-radius:24px;background:#10162dee;color:#f3dfed;font:inherit;font-size:12px;cursor:pointer;min-height:40px}.walker-toggle:focus-visible{outline:2px solid #f6acd4;outline-offset:4px}@keyframes character-step{0%,100%{transform:translateY(0) rotate(var(--lean,2deg))}50%{transform:translateY(-2px) rotate(0deg)}}@media(max-width:600px){.roaming-character{bottom:58px;width:86px}.walker-toggle{font-size:11px}}@media(prefers-reduced-motion:reduce){.walking .walker-art,.walking .leg-back,.walking .leg-front{animation:none}}.walker-art .singing-character-art{display:none;z-index:5}.singing .walker-art .singing-character-art{display:block}.singing .walker-art .upper-body,.singing .walker-art .leg-back,.singing .walker-art .leg-front,.singing .singing-mouth,.singing .singing-microphone{display:none}.singing-mouth-cover{display:none}.singing .singing-mouth-cover{display:block;position:absolute;left:51%;top:29.4%;width:7%;height:4.2%;border-radius:45%;background:#ffceb4;z-index:6}.singing .singing-mouth{display:block;z-index:7;left:52%;top:30%;width:5.5%;height:2.8%;box-shadow:none}@media(prefers-reduced-motion:reduce){.singing .singing-mouth,.singing .singing-mouth-cover{display:none}}</style>
