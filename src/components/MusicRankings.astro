---
import rankings from '../data/rankings.json';
interface Props {ja:boolean}
const {ja}=Astro.props;const lang=ja?'ja':'en';
for(const group of rankings){const seen=new Set();for(const [i,e] of group.entries.entries()){if(e.position!==i+1||seen.has(e.url)||new URL(e.url).protocol!=='https:')throw Error('Invalid ranking data');seen.add(e.url);}}
---
<div class="ranking-grid">{rankings.map(group=><article class="ranking-card"><p class="eyebrow">{group.platform}</p><h2>{group.label[lang]}</h2><p class="scope">{group.scope[lang]}</p><p class="date">{ja?'確認日':'Observed'}: <time datetime={group.observedAt}>{group.observedAt}</time></p><ol>{group.entries.map(entry=><li><span class="rank-number" aria-hidden="true">{String(entry.position).padStart(2,'0')}</span><a href={entry.url} target="_blank" rel="noopener noreferrer">{entry.title}<span aria-hidden="true"> ↗</span></a></li>)}</ol><a class="text-link" href={group.source} target="_blank" rel="noopener noreferrer">{ja?'出典：公式ページ':'Source: official page'} ↗</a></article>)}</div>
<style>.ranking-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.ranking-card{border:1px solid #52405f;border-radius:20px;background:linear-gradient(145deg,#171c36,#131327);padding:28px;min-width:0}.ranking-card h2{font-size:24px;line-height:1.5}.scope,.date{font-size:13px;color:#c3c1d6;line-height:1.8}.ranking-card ol{padding:0;list-style:none;margin:25px 0}.ranking-card li{display:flex;gap:18px;align-items:baseline;border-top:1px solid #ffffff18;padding:18px 0}.rank-number{color:#f2a6d3;font-size:24px;min-width:34px;font-variant-numeric:tabular-nums}.ranking-card li a{color:#fff;text-decoration:none;overflow-wrap:anywhere;line-height:1.6}.ranking-card li a:hover{text-decoration:underline}.ranking-note{color:#c3c1d6;line-height:1.8;margin:0 0 32px}.ranking-note:last-child{margin:40px 0 0}.ranking-note h2{font-size:22px}@media(max-width:760px){.ranking-grid{grid-template-columns:1fr}.ranking-card{padding:22px}}</style>
