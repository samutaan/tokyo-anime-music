---
import data from '../data/video-rankings.json';
interface Props { ja: boolean }
const {ja}=Astro.props;
const seen=new Set<string>();
for(const group of data.groups) for(const [i,e] of group.entries.entries()) {
  if(e.position!==i+1 || seen.has(e.url) || e.title.includes('君の知らない物語') || !/^https:\/\/www.youtube.com\/watch\?v=[\w-]{11}$/.test(e.url) || (group.id==='long' ? e.seconds<600 : e.seconds>=600)) throw Error('Invalid video ranking');
  seen.add(e.url);
}
---
<section class="video-rankings" aria-labelledby="video-rankings-title">
  <p class="eyebrow">YOUTUBE / POPULAR VIDEOS</p>
  <h2 id="video-rankings-title">{ja?'人気の動画 TOP 10':'Popular videos · Top 10'}</h2>
  <p class="note">{ja?'公式チャンネルの「人気の動画」の掲載順をもとに、長さ別に選んだランキングです。「君の知らない物語」関連を除外し、各部門で1位から付け直しています。':'Selected from the official channel’s Popular videos order, grouped by length. Videos related to “Kimi no Shiranai Monogatari” are excluded; positions restart in each category.'}</p>
  <p class="note">{ja?'確認日':'Observed'}: <time datetime={data.observedAt}>{data.observedAt}</time> · {ja?'手動確認・リアルタイム更新ではありません。10分ちょうどは長編に含みます。':'Manually reviewed; not live rankings. Exactly 10 minutes belongs to the long category.'}</p>
  <div class="video-ranking-grid">{data.groups.map(group=><article>
    <h3>{group.id==='long'?(ja?'長編 · 10分以上':'Long · 10 minutes or more'):(ja?'短編 · 10分未満':'Short · Under 10 minutes')}</h3>
    <ol>{group.entries.map(entry=><li>
      <span class="position" aria-hidden="true">{String(entry.position).padStart(2,'0')}</span>
      <div><a href={entry.url} target="_blank" rel="noopener noreferrer">{entry.title} <span aria-hidden="true">↗</span></a><small>{ja?entry.duration:entry.duration.replace('時間','h').replace('分','m').replace('秒','s')}</small></div>
    </li>)}</ol>
  </article>)}</div>
  <a class="text-link" href={data.source} target="_blank" rel="noopener noreferrer">{ja?'出典：公式YouTubeの動画一覧':'Source: official YouTube videos'} ↗</a>
</section>
<style>
.video-rankings{margin:64px 0;min-width:0}.video-rankings h2{font-size:clamp(26px,4vw,40px)}.note{color:#c3c1d6;line-height:1.8;font-size:14px;max-width:85ch}.video-ranking-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px;margin:28px 0}.video-ranking-grid article{min-width:0;border:1px solid #52405f;border-radius:20px;background:linear-gradient(145deg,#171c36,#131327);padding:24px}.video-ranking-grid h3{font-size:22px;margin:0 0 20px}.video-ranking-grid ol{list-style:none;margin:0;padding:0}.video-ranking-grid li{display:flex;gap:16px;padding:18px 0;border-top:1px solid #ffffff18}.position{color:#f2a6d3;font-size:26px;min-width:36px;font-variant-numeric:tabular-nums}.video-ranking-grid a{color:#fff;text-decoration:none;line-height:1.6;overflow-wrap:anywhere}.video-ranking-grid a:hover{text-decoration:underline}.video-ranking-grid a:focus-visible{outline:2px solid #f2a6d3;outline-offset:4px}.video-ranking-grid small{display:block;color:#c3c1d6;margin-top:8px}@media(max-width:760px){.video-ranking-grid{grid-template-columns:1fr}.video-ranking-grid article{padding:20px}}
</style>
