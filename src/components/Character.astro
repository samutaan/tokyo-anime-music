---
interface Props { ja: boolean }
const {ja}=Astro.props;
---
<div class="character-animation">
<svg class="character-art" viewBox="0 0 600 600" role="img" aria-label={ja ? 'ピンクのヘッドホンを着けたTokyo Anime Musicの専用キャラクター' : 'Tokyo Anime Music character with pink headphones'}>
<defs>
<linearGradient id="hair-falloff" x1="155" y1="160" x2="45" y2="420" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="black"/><stop offset=".4" stop-color="#555"/><stop offset="1" stop-color="white"/></linearGradient>
<filter id="hair-feather" x="-30%" y="-20%" width="160%" height="140%"><feGaussianBlur stdDeviation="5"/></filter>
<mask id="hair-area" maskUnits="userSpaceOnUse" x="0" y="0" width="600" height="600"><path d="M0 242 Q70 218 126 166 L132 181 Q109 242 129 299 Q109 343 143 383 L64 425 0 449Z" fill="url(#hair-falloff)" filter="url(#hair-feather)"/></mask>

</defs>
<image href="/images/official-character.jpg" width="600" height="600"/>
<g mask="url(#hair-area)"><image class="sway-hair" href="/images/official-character.jpg" width="600" height="600"/></g>

</svg>
<button class="character-motion-toggle" type="button" aria-pressed="false" data-on={ja ? '動きを止める' : 'Pause animation'} data-off={ja ? '動きを再開' : 'Resume animation'}>{ja ? '動きを止める' : 'Pause animation'}</button>
</div>
<script>
const animation=document.querySelector<HTMLElement>('.character-animation');
const toggle=animation?.querySelector<HTMLButtonElement>('button');
if(animation && toggle){
 const preference=matchMedia('(prefers-reduced-motion: reduce)');
 const setPaused=(paused:boolean)=>{
 animation.classList.toggle('is-paused',paused);
 toggle.setAttribute('aria-pressed',String(paused));
 toggle.textContent=(paused ? toggle.dataset.off : toggle.dataset.on) ?? '';
 };
 setPaused(preference.matches);
 toggle.addEventListener('click',()=>setPaused(!animation.classList.contains('is-paused')));
 preference.addEventListener('change',()=>setPaused(preference.matches));
}
</script>
<style>
.character-animation{position:relative}
.character-art{display:block;width:100%;height:auto}
.sway-hair{transform-origin:145px 175px;animation:hair 9.4s ease-in-out infinite}
.character-motion-toggle{position:absolute;top:17%;left:50%;transform:translateX(-50%);border:1px solid #ffffff50;border-radius:20px;background:#12162dd9;color:white;padding:7px 12px;font:10px Arial,sans-serif;cursor:pointer;pointer-events:auto;white-space:nowrap;z-index:3}
.character-motion-toggle:focus-visible{outline:3px solid #96e5ff;outline-offset:3px}
.is-paused .sway-hair{animation:none;transform:none}
/* Fixed root, small uneven gusts, and a soft blend into the original hair. */
@keyframes hair{0%,100%{transform:rotate(0deg)}22%{transform:rotate(.42deg)}47%{transform:rotate(-.18deg)}68%{transform:rotate(.3deg)}84%{transform:rotate(-.12deg)}}
.is-paused .character-art{animation:none;transform:none}
@media(prefers-reduced-motion:reduce){.sway-hair{animation:none;transform:none}}
</style>
